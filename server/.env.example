# Use ONE of these. Never put keys in index.html.
# Free option (Google AI Studio):
GEMINI_API_KEY=
# GEMINI_MODEL=  (leave empty: the engine tries gemini-3.8-flash, then older ones)
# Paid option:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Real mandi prices (free key from data.gov.in: sign up, then My Account). Optional.
DATA_GOV_API_KEY=
