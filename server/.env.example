# Choose ollama, gemini, or anthropic. If omitted, provider selection uses the
# existing key-based behavior (Anthropic takes precedence over Gemini).
AI_PROVIDER=ollama

# Local Ollama API; the server always connects through 127.0.0.1.
OLLAMA_MODEL=qwen2.5:3b

# Cloud providers (only required when selected):
# Free option (Google AI Studio):
GEMINI_API_KEY=
# GEMINI_MODEL=  (leave empty: the engine tries gemini-3.8-flash, then older ones)
# Paid option:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Real mandi prices (free key from data.gov.in: sign up, then My Account). Optional.
DATA_GOV_API_KEY=
